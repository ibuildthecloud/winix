{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Add/Remove Programs registrations",
  "description": "System programs removed by stable uninstall-registry identity.",
  "type": "object",
  "propertyNames": {
    "pattern": "^[^\\s\\\\/](?:[^\\\\/]*[^\\s\\\\/])?$",
    "not": { "enum": [".", ".."] }
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "state": { "const": "absent" },
      "display_name": { "type": "string", "minLength": 1 }
    },
    "required": ["state", "display_name"],
    "additionalProperties": false
  }
}
